#!/usr/bin/env bash
# Pre-commit hook: regenerate filament_libraries.json whenever any file
# under filaments/ is staged for commit.

FILAMENTS_DIR="filaments"
MANIFEST="filament_libraries.json"
SCRIPT="generate_filament_manifest.py"

# Check if any staged files touch the filaments directory
if git diff --cached --name-only | grep -q "^${FILAMENTS_DIR}/"; then
    echo "[pre-commit] filaments/ changed — regenerating ${MANIFEST}..."

    if ! command -v python3 &>/dev/null && ! command -v python &>/dev/null; then
        echo "[pre-commit] ERROR: python not found. Install Python 3 and re-commit."
        exit 1
    fi

    PYTHON=$(command -v python3 || command -v python)

    if ! "$PYTHON" "${SCRIPT}" --dir "${FILAMENTS_DIR}" --out "${MANIFEST}"; then
        echo "[pre-commit] ERROR: manifest generation failed. Aborting commit."
        exit 1
    fi

    git add "${MANIFEST}"
    echo "[pre-commit] ${MANIFEST} updated and staged."
fi
