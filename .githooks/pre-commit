#!/bin/sh
# 1. Strip Owned=true from staged filament JSON files.
# 2. Regenerate filament_libraries.json whenever filament files change.
# 3. Regenerate libraries.json whenever anything under libraries/ changes.
#
# Install once per clone:
#   git config core.hooksPath .githooks

python3 - <<'PYEOF'
import re, subprocess, sys
from pathlib import Path

staged = subprocess.run(
    ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'],
    capture_output=True, text=True
).stdout.splitlines()

# Step 1: strip Owned=true from staged filament JSON files
for path in staged:
    if not path.endswith('.json'):
        continue
    p = Path(path)
    if not p.exists():
        continue
    text = p.read_text(encoding='utf-8')
    if '"Filaments"' not in text:
        continue
    new_text, n = re.subn(r'("Owned"\s*:\s*)true', r'\1false', text)
    if n:
        p.write_text(new_text, encoding='utf-8')
        subprocess.run(['git', 'add', path], check=True)
        print(f'pre-commit: cleared Owned=true in {path} ({n} entr{"y" if n == 1 else "ies"})')

# Step 2: regenerate manifest if any filament files (or the manifest itself) were staged
FILAMENTS_DIR = 'filaments'
MANIFEST = 'filament_libraries.json'

needs_regen = any(
    p.startswith(FILAMENTS_DIR + '/') or p == MANIFEST
    for p in staged
)
if needs_regen:
    print(f'pre-commit: filaments changed — regenerating {MANIFEST}...')
    result = subprocess.run(['python3', 'generate_filament_manifest.py'], capture_output=False)
    if result.returncode != 0:
        print(f'pre-commit: ERROR: manifest generation failed. Aborting commit.', file=sys.stderr)
        sys.exit(1)
    subprocess.run(['git', 'add', MANIFEST], check=True)
    print(f'pre-commit: {MANIFEST} updated and staged.')

# Step 3: regenerate libraries.json (library hot-update manifest) if any library payload,
# meta or contract under libraries/ -- including a deletion -- or the manifest itself was
# staged. sys.executable is whichever Python runs this hook (python3 or python).
LIBRARIES_DIR = 'libraries'
LIB_MANIFEST = 'libraries.json'

all_staged = subprocess.run(
    ['git', 'diff', '--cached', '--name-only'],
    capture_output=True, text=True
).stdout.splitlines()
if any(p.startswith(LIBRARIES_DIR + '/') or p == LIB_MANIFEST for p in all_staged):
    print(f'pre-commit: libraries changed — regenerating {LIB_MANIFEST}...')
    result = subprocess.run([sys.executable, 'generate_library_manifest.py'])
    if result.returncode != 0:
        print(f'pre-commit: ERROR: library manifest generation failed. Aborting commit.', file=sys.stderr)
        sys.exit(1)
    subprocess.run(['git', 'add', LIB_MANIFEST], check=True)
    print(f'pre-commit: {LIB_MANIFEST} updated and staged.')
PYEOF
